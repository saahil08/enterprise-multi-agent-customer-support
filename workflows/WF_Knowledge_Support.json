    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const responseData = $json;\nconst original = $(\"Code - Prepare User Memory Request\").first().json;\nconst assistantMessage = responseData.response;\nif (typeof assistantMessage !== \"string\" || !assistantMessage.trim()) {\n  throw new Error(\"Assistant response is missing. Cannot save assistant conversation memory.\");\n}\nreturn {json:{\n  ...responseData,\n  correlation_id: original.correlation_id ?? null,\n  execution_id: original.execution_id ?? String($execution.id),\n  session_id: original.session_id ?? null,\n  message: assistantMessage.trim(),\n  role: \"assistant\",\n  telegram_chat_id: String(original.telegram_chat_id),\n  telegram_user_id: String(original.telegram_user_id),\n  telegram_update_id: String(original.telegram_update_id)\n}};"
