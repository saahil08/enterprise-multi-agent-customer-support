        "jsCode": "const savedRequest = $(\"Code - Prepare Assistant Memory Request\").first().json;\nconst { message, role, telegram_update_id, ...response } = savedRequest;\nconst trigger = $(\"When Executed by Another Workflow\").first().json;\nreturn {json:{\n  ...response,\n  memory_saved: true,\n  correlation_id: trigger.correlation_id ?? response.correlation_id ?? null,\n  execution_id: trigger.execution_id ?? response.execution_id ?? String($execution.id),\n  workflow_name: \"WF_Knowledge_Support\",\n  event_name: \"knowledge_support_completed\",\n  logged_at: new Date().toISOString()\n}};"
