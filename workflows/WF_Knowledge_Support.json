    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst input = $json;\n\nconst message = input.message ?? input.content;\nconst chatId = String(input.telegram_chat_id ?? \"\");\nconst userId = String(input.telegram_user_id ?? \"\");\nconst updateId = String(input.telegram_update_id ?? \"\");\n\nif (!message || !String(message).trim()) {\n  throw new Error(\"Customer message is missing.\");\n}\n\nif (!chatId || !userId || !updateId) {\n  throw new Error(\n    \"Telegram chat ID, user ID or update ID is missing. Cannot create conversation memory.\"\n  );\n}\n\nreturn {\n  json: {\n    ...input,\n    message: String(message).trim(),\n    role: \"user\",\n    telegram_chat_id: chatId,\n    telegram_user_id: userId,\n    telegram_update_id: updateId\n  }\n};\n"
      },
