{
  "name": "WF_Order_Support",
  "nodes": [
    {
      "parameters": {
        "jsCode": "\nconst inputs = $input.all();\n\nreturn inputs.map((item) => {\n  const data = item.json;\n  const message = String(data.message ?? \"\");\n  const currentMatch = message.match(/\\bORD\\d+\\b/i);\n\n  let orderId = currentMatch?.[0]?.toUpperCase() ?? null;\n  let orderIdSource = orderId ? \"current_message\" : null;\n\n  // For follow-up questions such as \"where is it now?\", use only\n  // the most recent order number previously supplied by the user.\n  if (!orderId && Array.isArray(data.conversation_history)) {\n    const previousUserMessages = data.conversation_history\n      .filter(entry => entry.role === \"user\" && typeof entry.content === \"string\")\n      .slice()\n      .reverse();\n\n    for (const entry of previousUserMessages) {\n      const previousMatch = entry.content.match(/\\bORD\\d+\\b/i);\n      if (previousMatch) {\n        orderId = previousMatch[0].toUpperCase();\n        orderIdSource = \"conversation_history\";\n        break;\n      }\n    }\n  }\n\n  if (!orderId) {\n    return {\n      json: {\n        ...data,\n        input_valid: false,\n        status: \"order_id_missing\",\n        order_id: null,\n        response: \"Please provide your order number, for example ORD1001.\"\n      }\n    };\n  }\n\n  return {\n    json: {\n      ...data,\n      input_valid: true,\n      status: \"order_id_extracted\",\n      order_id: orderId,\n      order_id_source: orderIdSource,\n      PK: `ORDER#${orderId}`,\n      SK: \"DETAILS\"\n    }\n  };\n});\n"
      },
