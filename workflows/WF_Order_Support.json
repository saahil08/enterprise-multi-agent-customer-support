      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst supportResult = { ...$json };\nconst response = String(supportResult.response ?? \"\").trim();\nif (!response) throw new Error(\"Order Support response is empty.\");\nconst trigger = $(\"When call by supervisor\").first().json;\nconst chatId = String(trigger.telegram_chat_id ?? \"\");\nconst userId = String(trigger.telegram_user_id ?? \"\");\nconst updateId = String(trigger.telegram_update_id ?? \"\");\nif (!chatId || !userId || !updateId) {\n  throw new Error(\"Telegram identifiers are missing for assistant memory.\");\n}\nreturn {\n  json: {\n    message: response,\n    role: \"assistant\",\n    telegram_chat_id: chatId,\n    telegram_user_id: userId,\n    telegram_update_id: updateId,\n    support_result: { ...supportResult, correlation_id: trigger.correlation_id ?? null, execution_id: trigger.execution_id ?? String($execution.id) }\n  }\n};\n"
