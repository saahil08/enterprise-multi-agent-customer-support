    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst parsed = $json.output && typeof $json.output === 'object' ? $json.output : {};\nconst response = String(parsed.response ?? '').trim();\nconst trigger = $('When Executed by Another Workflow').first().json;\nconst customer = $('Extract Customer ID').first().json;\nif (!response) {\n  return {json:{\n    response:\"I'm unable to provide a customer profile response right now. Please contact support.\",\n    status:\"temporarily_unavailable\", agent:\"customer_support_agent\",\n    intent:\"customer_profile_lookup\", requires_human:true,\n    correlation_id:trigger.correlation_id ?? null,\n    execution_id:trigger.execution_id ?? String($execution.id),\n    customer_id:customer.customer_id ?? null\n  }};\n}\nreturn {json:{\n  response, status:\"success\", agent:\"customer_support_agent\",\n  intent:\"customer_profile_lookup\", requires_human:false,\n  correlation_id:trigger.correlation_id ?? null,\n  execution_id:trigger.execution_id ?? String($execution.id),\n  customer_id:customer.customer_id ?? null\n}};\n"
