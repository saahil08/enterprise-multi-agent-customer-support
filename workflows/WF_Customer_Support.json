    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const current = $('When Executed by Another Workflow').first().json;\nconst memory = $json ?? {};\nconst currentMessage = String(current.message ?? '');\nconst history = Array.isArray(memory.conversation_history) ? memory.conversation_history : [];\nconst pattern = /\\b(?:customer\\s*(?:id|number)?\\s*)#?\\s*(\\d{4,})\\b/i;\nlet customerId = currentMessage.match(pattern)?.[1] ?? null;\nif (!customerId) {\n  for (const entry of [...history].reverse()) {\n    if (entry?.role !== 'user' || typeof entry.content !== 'string') continue;\n    const match = entry.content.match(pattern);\n    if (match) { customerId = match[1]; break; }\n  }\n}\nreturn {json:{\n  customer_id: customerId ? String(customerId) : null,\n  conversation_history: history,\n  history_text: String(memory.history_text ?? ''),\n  current_message: currentMessage,\n  telegram_chat_id: String(current.telegram_chat_id ?? ''),\n  telegram_user_id: String(current.telegram_user_id ?? ''),\n  telegram_update_id: String(current.telegram_update_id ?? ''),\n  correlation_id: current.correlation_id ?? null,\n  execution_id: current.execution_id ?? String($execution.id),\n  session_id: current.session_id ?? `${current.telegram_chat_id}:${current.telegram_user_id}`\n}};"
      },
