      "parameters": {
        "jsCode": "\nconst record = $input.first()?.json ?? {};\nconst blocked = /(password|passwd|secret|token|api.?key|ssn|tax.?id|card|bank|account.?number|phone|mobile|email|address|dob|birth|identity|auth)/i;\nconst safeRecord = {};\nfor (const [key, value] of Object.entries(record)) {\n  if (key === 'PK' || key === 'SK' || blocked.test(key)) continue;\n  if (value === null || ['string','number','boolean'].includes(typeof value)) safeRecord[key] = value;\n}\nreturn [{json:{...safeRecord, _profile_found:true}}];\n"
      },
