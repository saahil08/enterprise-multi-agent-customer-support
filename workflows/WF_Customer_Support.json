        "jsCode": "const guarded = $json;\nconst output = String(guarded.response ?? guarded.output?.response ?? guarded.output ?? '').trim();\nif (!output) throw new Error(\"Customer Support guarded response is empty.\");\nconst trigger = $(\"When Executed by Another Workflow\").first().json;\nconst supportResult = {\n  response: output,\n  status: guarded.status ?? \"success\",\n  agent: \"customer_support_agent\",\n  intent: guarded.intent ?? \"customer_profile_lookup\",\n  guardrail_decision: guarded.guardrail_decision ?? \"PASSED\",\n  guardrail_state: guarded.guardrail_state ?? null,\n  correlation_id: trigger.correlation_id ?? null,\n  execution_id: trigger.execution_id ?? String($execution.id),\n  customer_id: $(\"Extract Customer ID\").first().json.customer_id ?? null\n};\nreturn { json: {\n  message: output, role: \"assistant\",\n  telegram_chat_id: String(trigger.telegram_chat_id ?? \"\"),\n  telegram_user_id: String(trigger.telegram_user_id ?? \"\"),\n  telegram_update_id: String(trigger.telegram_update_id ?? \"\"),\n  support_result: supportResult\n} };"
